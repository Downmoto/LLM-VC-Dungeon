# service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434

# frontend build-time api base url
VITE_API_URL=http://localhost:8000

# backend runtime configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173,http://localhost:4173,http://127.0.0.1:4173,http://0.0.0.0:4173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0)(:\d+)?$


# provider credentials
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# model settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GEN_MODEL=qwen3:8b
OLLAMA_CLASSIFY_MODEL=functiongemma:latest
OPENAI_GEN_MODEL=gpt-4o-mini
OPENAI_CLASSIFY_MODEL=gpt-4o-mini
GOOGLE_GEN_MODEL=gemini-3.1-pro-preview
GOOGLE_CLASSIFY_MODEL=gemini-1.5-flash

# game settings
GAME_MODE=llm
ENABLE_LLM_NARRATION=true
HISTORY_RECENT_TURNS=8
HISTORY_SUMMARY_MAX_CHARS=700

# llm controls
AGENT_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=12.0

# save/load policy
# api save paths are restricted to the backend data directory

LLM_PROVIDER=google